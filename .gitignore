node_modules

# build output
/build
/.svelte-kit

# env
.env
.env.*

# Vite
vite.config.js.timestamp-*

# Content precompile scratch space (scripts/precompile-content.mjs).
/.build-tmp

# Runtime binaries, downloaded by scripts/sync-runtime.mjs from the pinned
# agda-als-dist release.
/static/als-*.wasm
/static/als-*.wasm.gz
/static/agda-data.zip
/static/agda-stdlib-*.zip

# Verified download cache (keyed by SHA-256), reused across builds.
/.runtime-cache/

# Standard-library interfaces, populated by scripts/sync-runtime.mjs in the
# same-origin mode; other modes fetch them over the network instead.
/static/stdlib-interfaces/

# Generated content output; the sources live in content/ and the precompiled
# interface archives under static/content/interfaces/ are kept for the fast path.
/static/content/*
!/static/content/interfaces/
!/static/content/interfaces/**
