{
  "name": "agda-playground",
  "version": "0.1.0",
  "description": "A complete Agda 2.8 editor and interaction environment running in the browser through WebAssembly.",
  "type": "module",
  "private": true,
  "//": "vite is capped at ~8.2.2 (<8.3.0) on purpose. Vite 8.3.0+ leaves the '?worker&inline' query in the URL it generates for new Worker(new URL('...?worker&inline', import.meta.url)). The browser then loads Vite's worker-wrapper module as the worker itself, so the Agda WASM worker never runs and the UI hangs on 'Starting Agda 100%'. Lift this cap once upstream is fixed.",
  "scripts": {
    "dev": "vite dev",
    "predev": "node scripts/sync-runtime.mjs && node scripts/sync-content.mjs",
    "build": "node scripts/sync-runtime.mjs && node scripts/sync-content.mjs && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || true",
    "svelte-kit-sync": "svelte-kit sync && rm -f node_modules/.tmp/*.tsbuildinfo",
    "sync:runtime": "node scripts/sync-runtime.mjs",
    "sync:content": "node scripts/sync-content.mjs",
    "precompile:content": "node scripts/precompile-content.mjs",
    "index:content-interfaces": "node scripts/index-content-interfaces.mjs",
    "benchmark:content": "node scripts/benchmark-content.mjs",
    "tsc": "tsc -b",
    "check": "npm run svelte-kit-sync && svelte-check --tsconfig ./tsconfigs/tsconfig.app.json",
    "check:watch": "npm run svelte-kit-sync && svelte-check --tsconfig ./tsconfigs/tsconfig.app.json --watch",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.4.0",
    "@typescript-eslint/types": "^8.68.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.57.0",
    "svelte-check": "^4.4.5",
    "typescript": "^5.9.3",
    "vite": "~8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19.0 <25.0.0"
  },
  "dependencies": {
    "@andy0130tw/vscode-jsonrpc-esm": "^9.0.0-next-esm.9",
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.2",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/lsp-client": "^6.2.2",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.16",
    "@lucide/svelte": "^1.37.0",
    "@runno/wasi": "^0.10.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "codemirror": "6.0.2",
    "comlink": "^4.4.2",
    "jszip": "^3.10.1",
    "marked": "^16.4.2",
    "spsc": "^0.0.7",
    "zod": "^4.3.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
